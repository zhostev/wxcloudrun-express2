<view class="container">
  <!-- 余额 hero 卡片 -->
  <view class="hero" wx:if="{{summary}}">
    <view class="hero-title">904班 · 班级公益账本</view>
    <view class="hero-balance-label">当前余额</view>
    <view class="hero-balance">¥{{summary.balance}}</view>
    <view class="hero-stats">
      <view class="hero-stat">
        <view class="hero-stat-label">收到捐赠</view>
        <view class="hero-stat-value">¥{{summary.received}}</view>
      </view>
      <view class="hero-stat">
        <view class="hero-stat-label">累计支出</view>
        <view class="hero-stat-value">¥{{summary.spent}}</view>
      </view>
      <view class="hero-stat">
        <view class="hero-stat-label">待审批</view>
        <view class="hero-stat-value">{{summary.pendingCount}} 笔</view>
      </view>
    </view>
  </view>
  <view class="loading" wx:if="{{loading}}">加载中…</view>
  <view class="card" wx:if="{{loadError}}">
    <view class="muted" style="text-align:center">{{loadError}}</view>
  </view>

  <!-- 审批入口（有权限才显示） -->
  <view class="card approval-entry" wx:if="{{canApprove}}" bindtap="goApproval">
    <view class="between">
      <view>
        <view style="font-weight:600">待审批事项</view>
        <view class="muted small">支出需要审批后才会公示</view>
      </view>
      <view class="row">
        <view class="red-dot" wx:if="{{pendingCount > 0}}">{{pendingCount}}</view>
        <view class="link">去处理 ›</view>
      </view>
    </view>
  </view>

  <!-- 最近动态 -->
  <view class="card" wx:if="{{!loading && !loadError}}">
    <view class="between" style="margin-bottom:16rpx">
      <view class="section-title" style="margin:0">最近动态</view>
      <view class="link" bindtap="goLedger">全部明细 ›</view>
    </view>
    <view wx:if="{{recent.length === 0}}" class="muted" style="text-align:center;padding:40rpx 0">
      本学期还没有已公示的收支记录
    </view>
    <view class="ledger-row" wx:for="{{recent}}" wx:key="id" bindtap="goEntry" data-id="{{item.id}}">
      <view class="ledger-main">
        <view class="ledger-date">{{item.date}}</view>
        <view class="ledger-info">
          <view class="ledger-title">{{item.title}}</view>
          <view class="ledger-sub muted small">{{item.sub}}</view>
        </view>
      </view>
      <view class="ledger-amount {{item.donation ? 'positive' : 'negative'}}">{{item.amountText}}</view>
    </view>
  </view>

  <!-- 分享 -->
  <button class="primary-btn" bindtap="goShare" wx:if="{{!loading}}">生成分享卡</button>
  <view class="muted small" style="text-align:center;margin-top:20rpx">账目定期公示 · 接受全班监督</view>
</view>
