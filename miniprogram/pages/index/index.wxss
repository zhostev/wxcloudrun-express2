.hero {
  background: linear-gradient(135deg, #3b82f6, #1d4ed8);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(29, 78, 216, 0.25);
}
.hero-title { font-size: 30rpx; opacity: 0.9; }
.hero-balance-label { margin-top: 24rpx; font-size: 26rpx; opacity: 0.85; }
.hero-balance { font-size: 64rpx; font-weight: 700; margin-top: 6rpx; }
.hero-stats { display: flex; margin-top: 28rpx; border-top: 2rpx solid rgba(255,255,255,.25); padding-top: 20rpx; }
.hero-stat { flex: 1; }
.hero-stat-label { font-size: 24rpx; opacity: 0.8; }
.hero-stat-value { font-size: 32rpx; font-weight: 600; margin-top: 6rpx; }
.approval-entry { border-left: 8rpx solid #f59e0b; }
.red-dot {
  background: #dc2626; color: #fff; font-size: 24rpx; font-weight: 700;
  min-width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center;
  border-radius: 20rpx; padding: 0 10rpx; margin-right: 12rpx;
}
.link { color: #1d4ed8; font-size: 26rpx; }
.ledger-row { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 0; border-bottom: 2rpx solid #f3f4f6; }
.ledger-row:last-child { border-bottom: none; }
.ledger-main { display: flex; align-items: center; flex: 1; overflow: hidden; }
.ledger-date { color: #9ca3af; font-size: 24rpx; width: 96rpx; flex-shrink: 0; }
.ledger-info { flex: 1; overflow: hidden; }
.ledger-title { font-size: 30rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ledger-sub { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 4rpx; }
.ledger-amount { font-size: 32rpx; font-weight: 600; margin-left: 16rpx; flex-shrink: 0; }
button.primary-btn { margin-top: 8rpx; }
