<view class="container">
  <view class="loading" wx:if="{{loading}}">加载中…</view>
  <view class="card" wx:if="{{loadError}}">
    <view class="muted" style="text-align:center">{{loadError}}</view>
  </view>
  <view wx:if="{{!loading && !loadError}}">
    <view class="muted small" style="margin-bottom:12rpx" wx:if="{{total > 0}}">已公示 {{total}} 笔</view>
    <view class="card" style="padding-top:8rpx;padding-bottom:8rpx" wx:if="{{items.length > 0}}">
      <view class="ledger-row" wx:for="{{items}}" wx:key="id" bindtap="goEntry" data-id="{{item.id}}">
        <view class="ledger-main">
          <view class="ledger-date">{{item.date}}</view>
          <view class="ledger-info">
            <view class="ledger-title">{{item.title}}</view>
            <view class="ledger-sub muted small">{{item.sub}}<text wx:if="{{item.hasReceipt}}"> · 有凭证</text></view>
          </view>
        </view>
        <view class="ledger-amount {{item.donation ? 'positive' : 'negative'}}">{{item.amountText}}</view>
      </view>
    </view>
    <view class="empty" wx:if="{{items.length === 0}}">本学期还没有已公示的收支记录</view>
    <view class="muted small" style="text-align:center;padding:20rpx 0" wx:if="{{loadingMore}}">加载更多…</view>
    <view class="muted small" style="text-align:center;padding:20rpx 0" wx:if="{{noMore && items.length > 0}}">— 到底了 —</view>
  </view>
</view>
